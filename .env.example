APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
# Shared secret(s) accepted by protected endpoints (comma-separated for multiple callers).
# API_KEY below is what the Next.js app's server-side proxy sends; it must be one of these
# values. docker-compose passes it through to the app service as NEXUS_API_KEY.
API_KEYS=dev-demo-key
API_KEY=dev-demo-key

POSTGRES_HOST=localhost
# 5433, not 5432: a native PostgreSQL Windows service commonly occupies host port 5432
# and silently intercepts connections meant for the docker-compose db container.
POSTGRES_PORT=5433
POSTGRES_DB=enterprise_rag
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
DATABASE_URL=postgresql+psycopg://rag_user:rag_password@localhost:5433/enterprise_rag

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MIN_RETRIEVAL_SCORE=0.5
RAG_RETRIEVAL_BACKEND=auto

# Second-stage cross-encoder reranking (retrieval/reranker.py) -- no new dependency,
# reuses sentence-transformers. Improves ranking precision at the cost of a local
# CPU inference pass per request; disable if you need the lowest possible latency.
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_POOL=20
RERANK_MIN_SCORE=0.2

# History-aware query rewriting (generation/query_rewriter.py) -- condenses a follow-up
# question plus prior turns into a standalone query before retrieval runs, so retrieval
# stays on-topic across a conversation instead of just searching the raw follow-up text.
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MAX_RETRIES=0
QUERY_REWRITE_TIMEOUT_SECONDS=6.0
MAX_HISTORY_TURNS=6

# LLM_PROVIDERS is an ordered, comma-separated fallback chain (see
# generation/providers/chain.py): each provider is tried in turn, with retries, before
# moving to the next. "auto" (the default) tries every provider below that has an API
# key set, in a fixed free-tier-friendly order (gemini, groq, openrouter, openai,
# anthropic), and always ends in "mock" -- a deterministic, always-succeeds answer used
# whenever no key is configured or every real provider fails, so /ask never breaks.
#
# Get a free Gemini key: https://aistudio.google.com/apikey
# Get a free Groq key:   https://console.groq.com/keys
LLM_PROVIDERS=auto
LLM_MAX_RETRIES=1
LLM_RETRY_BASE_DELAY=0.5
LLM_TIMEOUT_SECONDS=10.0

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local server, no API key needed -- only used if explicitly listed in LLM_PROVIDERS
# (e.g. LLM_PROVIDERS=ollama,mock), never auto-activated by LLM_PROVIDERS=auto.
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
